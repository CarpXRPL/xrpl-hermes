# XRPL-Hermes optional local configuration

# RPC endpoint you operate or separately trust. Public endpoints are used when unset.
# XRPL_PRIVATE_RPC=https://your-rpc.example

# Required only for the local `xaman-payload` Payment handoff.
# Keep these out of chat, MCP config, logs, and source control.
# XUMM_API_KEY=your-application-key
# XUMM_API_SECRET=your-application-secret
